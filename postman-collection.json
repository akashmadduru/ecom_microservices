          "name": "Remove Item from Cart (TRIGGERS EVENT)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8084/api/v1/carts/user123/items/item-uuid-here",
              "protocol": "http",
              "host": ["localhost"],
