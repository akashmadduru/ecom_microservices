# Copy to .env for local host development (`cd services/api_gateway && cp .env.example .env`).
# .env is gitignored — never commit it. This file is committed and must never
# contain a real secret.

# ---- Base settings (ecom_common.settings.BaseServiceSettings) ----
SERVICE_NAME=api-gateway
ENV=dev
LOG_LEVEL=INFO

# The gateway has no database of its own — DATABASE_URL is unused.
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=

# Required — no default, service refuses to boot without it. Must match every
# backend service's JWT_SECRET (they all verify the same tokens).
JWT_SECRET=dev-jwt-secret-32-chars-minimum-not-for-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=ecom-auth-service
JWT_AUDIENCE=ecom-gateway

CORS_ORIGINS=http://localhost:5173

OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

# ---- api_gateway-specific settings ----
# Upstream base URLs — docker-compose service DNS by default; point at
# localhost:<port> instead when running upstreams on the host too.
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
PRODUCT_SERVICE_URL=http://localhost:8003
INVENTORY_SERVICE_URL=http://localhost:8004
CART_SERVICE_URL=http://localhost:8005
WISHLIST_SERVICE_URL=http://localhost:8006
ORDER_SERVICE_URL=http://localhost:8007
PAYMENT_SERVICE_URL=http://localhost:8008
NOTIFICATION_SERVICE_URL=http://localhost:8009
SEARCH_SERVICE_URL=http://localhost:8010
REVIEW_SERVICE_URL=http://localhost:8011

RATE_LIMIT_ANONYMOUS_PER_MINUTE=100
RATE_LIMIT_USER_PER_MINUTE=300

UPSTREAM_CONNECT_TIMEOUT_SECONDS=2.0
UPSTREAM_READ_TIMEOUT_SECONDS=15.0
UPSTREAM_WRITE_TIMEOUT_SECONDS=10.0
UPSTREAM_POOL_TIMEOUT_SECONDS=5.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30.0
