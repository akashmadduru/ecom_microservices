# Copy to .env for local host development (`cd services/product_service && cp .env.example .env`).
# .env is gitignored — never commit it. This file is committed and must never
# contain a real secret.

# ---- Base settings (ecom_common.settings.BaseServiceSettings) ----
SERVICE_NAME=product-service
ENV=dev
LOG_LEVEL=INFO

# Port 5432 matches docker-compose.infra.yml (postgres+redis only, for
# running this service on the host); the full docker-compose.yml stack maps
# postgres to host port 5441 instead to avoid clashing with a locally
# installed Postgres — adjust if you're pointing at that stack instead.
DATABASE_URL=postgresql+asyncpg://product_user:product_user@localhost:5432/product_db
REDIS_URL=redis://localhost:6379
# Leave empty to boot without Kafka (events are skipped, not fatal).
KAFKA_BOOTSTRAP_SERVERS=

# Required — no default, service refuses to boot without it. 32+ random chars.
JWT_SECRET=dev-jwt-secret-32-chars-minimum-not-for-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=ecom-auth-service
JWT_AUDIENCE=ecom-gateway

CORS_ORIGINS=http://localhost:5173

OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

# ---- product_service-specific settings ----
PRODUCT_CACHE_TTL_SECONDS=300
# Absolute path to products.csv; empty disables the /admin/products/seed endpoint.
SEED_CSV_PATH=./seed/products.csv
