# Copy to .env for local host development (`cd services/auth_service && cp .env.example .env`).
# .env is gitignored — never commit it. This file is committed and must never
# contain a real secret.

# ---- Base settings (ecom_common.settings.BaseServiceSettings) ----
SERVICE_NAME=auth-service
ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://auth_user:auth_user@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379
# Leave empty to boot without Kafka (events are skipped, not fatal).
KAFKA_BOOTSTRAP_SERVERS=

# Required — no default, service refuses to boot without it. 32+ random chars.
JWT_SECRET=dev-jwt-secret-32-chars-minimum-not-for-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=ecom-auth-service
JWT_AUDIENCE=ecom-gateway

CORS_ORIGINS=http://localhost:5173

OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=

# ---- auth_service-specific settings ----
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Sign-In / SSO — leave both empty to disable Google SSO entirely.
# Client ID is not secret (it's embedded in frontend JS in real deployments);
# client secret is. Get both from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_REDIRECT_URI=http://localhost:8080/api/v1/auth/sso/google/callback
