# ---------------------------------------------------------------------------
# ops-build-runner configuration. Copy to `.env` and fill in. `.env` is
# gitignored. This is a NEW, separate credential surface from
# nuxt/ops-dashboard -- nothing here is shared with that app's .env.example.
# See docs/apps/ops-build-runner/DecisionLog.md for the full rationale.
# ---------------------------------------------------------------------------

# REQUIRED. Static bearer token for every request to this API. If unset, the
# API fails CLOSED (503) -- there is no default and no bypass. A NEW, separate
# credential from ops-dashboard's OPS_API_TOKEN -- never reuse that value here.
# Generate something unguessable, e.g.:
#   openssl rand -hex 32
BUILD_RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# Database. This service owns its OWN, dedicated Postgres instance -- NOT the
# platform's ecom_network Postgres (see docker-compose.yml's build-runner-db
# service). Two different connection strings, two different roles:
# ---------------------------------------------------------------------------

# REQUIRED. Used by the RUNNING APPLICATION (src/index.ts / src/db.ts). Points
# at the narrowly-scoped `build_runner_app` role -- INSERT/SELECT/UPDATE (never
# DELETE) on build_requests, INSERT/SELECT ONLY (no UPDATE/DELETE) on
# audit_log. See migrations/0003_app_role_and_privileges.sql.
DATABASE_URL=postgres://build_runner_app:${BUILD_RUNNER_APP_DB_PASSWORD}@build-runner-db:5432/build_runner

# REQUIRED (only for `npm run migrate`). A superuser / database-owner
# connection -- NEVER the narrow build_runner_app role above. Applies
# migrations/*.sql, including the migration that CREATEs build_runner_app
# itself, so this connection necessarily has more privilege than the role it
# provisions.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@build-runner-db:5432/build_runner

# REQUIRED (only for `npm run migrate`). The password migrations/0003 uses when
# creating/updating the build_runner_app role -- substituted into that
# migration file's ${BUILD_RUNNER_APP_DB_PASSWORD} placeholder at apply time
# (see src/migrate.ts). Never committed with a real value; DATABASE_URL above
# must use this same value.
BUILD_RUNNER_APP_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Approval notifier. Pluggable (src/notifier/), Slack webhook by explicit
# user choice for the real delivery path; console is local dev/testing ONLY.
# ---------------------------------------------------------------------------

# Deliberately NOT defaulted to "console". Only the exact string "console"
# opts into console-logged approval codes (local dev/testing only -- an
# operator with read access to this service's own logs could otherwise
# self-approve a build/launch, silently collapsing the two-action approval
# model). Unset, empty, or any other value all mean "slack" -- the safe,
# required default, which in turn REQUIRES SLACK_WEBHOOK_URL below.
APPROVAL_NOTIFIER=slack

# REQUIRED if APPROVAL_NOTIFIER=slack (the default). An incoming webhook URL.
# If APPROVAL_NOTIFIER is "slack" and this is unset, the service refuses to
# issue approval codes at all (503) rather than silently falling back to
# logging them to console.
SLACK_WEBHOOK_URL=

# Approval code time-to-live, in minutes. Applies to both the build-approval
# code and the launch-approval code (each measured from its own issuance
# time -- see migrations/0001_build_requests.sql's comment on why there is no
# separate expiry column). Defaults to 15 if unset.
APPROVAL_CODE_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# HTTP listen port.
# ---------------------------------------------------------------------------
PORT=4100

# ---------------------------------------------------------------------------
# Postgres superuser bootstrap (consumed by docker-compose.yml's
# build-runner-db service, mirroring the platform root .env.example's
# POSTGRES_USER/POSTGRES_PASSWORD convention).
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
