# ---------------------------------------------------------------------------
# ops-dashboard configuration. Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED. Static operator bearer token. Every /api/* request must present
# `Authorization: Bearer <this value>`. If unset, the API fails CLOSED (503) —
# there is no default and no bypass. Generate something unguessable, e.g.:
#   openssl rand -hex 32
OPS_API_TOKEN=

# ---------------------------------------------------------------------------
# Backend selection (Phase 3). `docker` (default) observes local Docker via the
# socket proxy; `kubernetes` observes a Kubernetes cluster (read-only) via the
# ambient kubeconfig. ONLY the exact string "kubernetes" switches — anything
# else (including unset) stays on Docker, so existing deployments are unchanged.
RUNTIME_MODE=docker

# Kubernetes-only. Namespace scope. Empty/unset = ALL namespaces (parity with
# Docker mode seeing the whole engine); set to one namespace to scope to it.
# The DOCKER_* / MUTATE_DOCKER_* vars below are ignored in kubernetes mode; the
# cluster is reached via KUBECONFIG / ~/.kube/config / in-cluster SA token, and
# the cluster's OWN RBAC is the only enforcement point (see README + the
# read-only manifest at k8s/ops-dashboard-readonly-rbac.yaml).
K8S_NAMESPACE=

# Hostname of the read-only docker-socket-proxy the dashboard talks to over TCP.
# Defaults to the compose service name below; override if you run the proxy
# elsewhere. The dashboard NEVER talks to /var/run/docker.sock directly.
DOCKER_HOST=docker-socket-proxy

# TCP port the socket proxy listens on (tecnativa/docker-socket-proxy default).
DOCKER_PORT=2375

# Hostname/port of a SEPARATE, dedicated mutate-only docker-socket-proxy (only
# used if Phase 2 mutations are enabled below). This must be a DIFFERENT proxy
# instance than DOCKER_HOST/PORT above — see docker-compose.ops.yml for why one
# proxy config can't safely serve both reads and mutations with this image.
MUTATE_DOCKER_HOST=docker-socket-proxy-mutate
MUTATE_DOCKER_PORT=2375

# ---------------------------------------------------------------------------
# Phase 2 mutating container controls (stop / start / restart). OFF BY DEFAULT.
# Leave these unset for the read-only posture. Enabling mutations requires ALL
# of the app-layer AND proxy-layer switches below — see docker-compose.ops.yml.
# ---------------------------------------------------------------------------

# GLOBAL kill switch. Only the exact string "true" enables mutations; anything
# else (including unset) makes every mutating endpoint return 403.
OPS_ALLOW_MUTATIONS=false

# Comma-separated compose service names (com.docker.compose.service label) that
# may be a mutation target. Empty => nothing is mutable even if the switch above
# is "true". Example: OPS_MANAGED_SERVICES=api-gateway,web
OPS_MANAGED_SERVICES=

# Proxy-layer granular toggles, applied to the SEPARATE mutate-only proxy
# (docker-socket-proxy-mutate) — never the read-only one. That proxy denies all
# non-GET requests unless POST is enabled, and only exposes the specific
# start/stop/restart verbs when the matching ALLOW_* is 1; it never enables
# CONTAINERS, so it can reach ONLY those specific sub-paths, never create/
# prune/list/inspect. All default to 0 (mutations disabled). Set all four to 1
# (together with the two app-layer vars above) to enable mutations end to end.
OPS_PROXY_POST=0
OPS_PROXY_ALLOW_START=0
OPS_PROXY_ALLOW_STOP=0
OPS_PROXY_ALLOW_RESTARTS=0

# ---------------------------------------------------------------------------
# Phase 5 image/volume/network mutating controls (named remove + prune).
# OFF BY DEFAULT. A THIRD, separate mutate-only proxy from the one above —
# never reuse RESOURCE_MUTATE_DOCKER_HOST/PORT's proxy for container
# lifecycle mutations, or vice versa.
# ---------------------------------------------------------------------------

# Hostname/port of a THIRD, dedicated image/volume/network mutate-only
# docker-socket-proxy. Must be a DIFFERENT proxy instance than BOTH
# DOCKER_HOST/PORT and MUTATE_DOCKER_HOST/PORT above — see
# docker-compose.ops.yml's docker-socket-proxy-mutate-resources comment.
RESOURCE_MUTATE_DOCKER_HOST=docker-socket-proxy-mutate-resources
RESOURCE_MUTATE_DOCKER_PORT=2375

# GLOBAL kill switch. Only the exact string "true" enables image/volume/
# network mutations; anything else (including unset) makes every mutating
# endpoint return 403. Independent of OPS_ALLOW_MUTATIONS above — an operator
# may want one without the other.
OPS_ALLOW_RESOURCE_MUTATIONS=false

# Comma-separated com.docker.compose.volume / com.docker.compose.network label
# values that may be a named-remove target. Empty => nothing removable even if
# the switch above is "true". Images have no equivalent list: eligibility
# there is state-based (zero live container references), re-derived per
# request, not a configured allowlist.
OPS_MANAGED_VOLUMES=
OPS_MANAGED_NETWORKS=

# Proxy-layer toggles for the THIRD proxy (docker-socket-proxy-mutate-resources).
# RESIDUAL RISK, stated plainly (an accepted, documented tradeoff — "Option A"
# in docs/apps/ops-dashboard/DecisionLog.md, not an oversight): unlike the
# container-mutate proxy's ALLOW_START/ALLOW_STOP/ALLOW_RESTARTS (independent,
# path-specific rules), images/volumes/networks have NO per-verb carve-out in
# this proxy image — enabling IMAGES/VOLUMES/NETWORKS=1 + POST=1 together also
# technically admits pull/create/push/connect at the PROXY layer. This app's
# own dockerode calls never issue those verbs (see
# docker-resource-mutating-provider.ts); the narrowing is enforced at the APP
# layer for this proxy, not the proxy layer. All default to 0 (disabled).
OPS_PROXY_RESOURCE_IMAGES=0
OPS_PROXY_RESOURCE_VOLUMES=0
OPS_PROXY_RESOURCE_NETWORKS=0
OPS_PROXY_RESOURCE_POST=0
