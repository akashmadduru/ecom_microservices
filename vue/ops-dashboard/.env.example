# ---------------------------------------------------------------------------
# ops-dashboard configuration. Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED. Static operator bearer token. Every /api/* request must present
# `Authorization: Bearer <this value>`. If unset, the API fails CLOSED (503) —
# there is no default and no bypass. Generate something unguessable, e.g.:
#   openssl rand -hex 32
OPS_API_TOKEN=

# Hostname of the read-only docker-socket-proxy the dashboard talks to over TCP.
# Defaults to the compose service name below; override if you run the proxy
# elsewhere. The dashboard NEVER talks to /var/run/docker.sock directly.
DOCKER_HOST=docker-socket-proxy

# TCP port the socket proxy listens on (tecnativa/docker-socket-proxy default).
DOCKER_PORT=2375
