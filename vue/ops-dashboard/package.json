{
  "name": "ops-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, read-only observability dashboard for local Docker containers. Talks to the Docker Engine API only via a read-only socket proxy.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "type-check": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "nuxt": "^4.5.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.13.2",
    "eslint": "^9.18.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.8"
  }
}
